{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LSU Demo: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-demo",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DSPARTA_SEARCH_DIR=${workspaceFolder}/../map/sparta/install"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "LSU Demo: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-demo",
                "--target",
                "lsu_issue_queue_demo",
                "-j",
                "8"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "LSU Demo: configure",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "LSU Demo: prepare debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-E",
                "make_directory",
                "${workspaceFolder}/build-demo/demo/lsu_issue_queue/output"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "LSU Demo: build",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "LSU Demo: run all",
            "type": "shell",
            "command": "${workspaceFolder}/demo/lsu_issue_queue/run_demo.sh",
            "args": [
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
